# i686 specific drivers
ARCH_DRIVERS := \
	$(DRIVER_DIR)/display/vga_text_display.c \

KERNEL_SRC += \
	$(ARCHDIR)/boot.S \
	$(ARCHDIR)/crti.S \
	$(ARCHDIR)/crtn.S \
	$(ARCHDIR)/drivers/drivers.c \
	$(ARCHDIR)/drivers/pit.c \
	$(ARCHDIR)/tty.c \
	$(ARCHDIR)/thread.c \
	$(ARCHDIR)/segmentation/gdt.c \
	$(ARCHDIR)/segmentation/load_gdt.S \
	$(ARCHDIR)/segmentation/load_tss.S \
	$(ARCHDIR)/segmentation/tss.c \
	$(ARCHDIR)/interrupts/interrupts.c \
	$(ARCHDIR)/interrupts/interrupt_handlers.S \
	$(ARCHDIR)/interrupts/load_idt.S \
	$(ARCHDIR)/interrupts/pic.c \
	$(ARCHDIR)/interrupts/ps2.c \
	$(ARCHDIR)/io.c \
	$(ARCHDIR)/paging.c \
	$(ARCHDIR)/processor.c \
	$(ARCHDIR)/tlb_invalid_page.S \
	$(ARCHDIR)/serial.c \
	$(ARCH_DRIVERS)

# Needed for global constructors to work
KERNEL_OBJS += \
	$(KERNEL_OUT)/$(ARCHDIR)/crtbegin.o \
	$(KERNEL_OUT)/$(ARCHDIR)/crtend.o \

$(KERNEL_OUT)/$(ARCHDIR)/crtbegin.o $(KERNEL_OUT)/$(ARCHDIR)/crtend.o:
	mkdir -p $(dir $@)
	OBJ=`$(TARGET_CC) $(CFLAGS) $(LDFLAGS) -print-file-name=$(@F)` && cp "$$OBJ" $@